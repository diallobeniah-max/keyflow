{
  "name": "keyflow",
  "private": true,
  "version": "0.3.0",
  "type": "module",
  "main": "dist-electron/main.js",
  "description": "KeyFlow - local-only Windows shortcut automation with tap patterns, popup menus and profiles.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "electron:compile": "tsc -p electron/tsconfig.json && tsc -p electron/tsconfig.preload.json",
    "native:build": "node scripts/build-keyflow-input.mjs",
    "electron:dev": "npm run native:build && node scripts/electron-dev.mjs",
    "electron:build": "npm run native:build && npm run build && npm run electron:compile && electron-builder build --win --config electron-builder.yml",
    "electron:dist": "npm run native:build && npm run build && npm run electron:compile && electron-builder build --win --publish never --config electron-builder.yml",
    "design:check": "node scripts/check-design-system.mjs",
    "ahk:smoke": "node scripts/ahk-smoke-test.mjs"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.1.0",
    "@types/node": "^22.10.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^43.1.1",
    "electron-builder": "^25.1.8",
    "sharp": "^0.33.5",
    "typescript": "^5.6.3",
    "uiohook-napi": "^1.5.5",
    "vite": "^5.4.11"
  }
}
